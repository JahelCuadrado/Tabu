<Window x:Class="Tabu.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Tabu.UI.ViewModels"
        xmlns:helpers="clr-namespace:Tabu.UI.Helpers"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        Title="Tabu"
        Icon="pack://application:,,,/Assets/tabu.ico"
        Height="{Binding BarHeight}" Width="800"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Left="0" Top="0">

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+Tab" Command="{Binding NextTabCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Tab" Command="{Binding PrevTabCommand}" />
        <KeyBinding Gesture="Ctrl+1" Command="{Binding GoToTabCommand}" CommandParameter="1" />
        <KeyBinding Gesture="Ctrl+2" Command="{Binding GoToTabCommand}" CommandParameter="2" />
        <KeyBinding Gesture="Ctrl+3" Command="{Binding GoToTabCommand}" CommandParameter="3" />
        <KeyBinding Gesture="Ctrl+4" Command="{Binding GoToTabCommand}" CommandParameter="4" />
        <KeyBinding Gesture="Ctrl+5" Command="{Binding GoToTabCommand}" CommandParameter="5" />
        <KeyBinding Gesture="Ctrl+6" Command="{Binding GoToTabCommand}" CommandParameter="6" />
        <KeyBinding Gesture="Ctrl+7" Command="{Binding GoToTabCommand}" CommandParameter="7" />
        <KeyBinding Gesture="Ctrl+8" Command="{Binding GoToTabCommand}" CommandParameter="8" />
        <KeyBinding Gesture="Ctrl+9" Command="{Binding GoToTabCommand}" CommandParameter="9" />
    </Window.InputBindings>

    <!-- Main bar container -->
    <Grid x:Name="BarContainer" Height="{Binding BarHeight}" VerticalAlignment="Top">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="BarTranslate" Y="0" />
        </Grid.RenderTransform>
        <!-- Background layer (opacity-controlled) -->
        <Border x:Name="BarBackground"
                Background="{DynamicResource SecondaryBackgroundBrush}"
                Opacity="{Binding BarOpacity}"
                CornerRadius="0,0,8,8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35" Color="Black" Direction="270" />
            </Border.Effect>
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{DynamicResource MainBar_CloseAllApps}"
                              Click="CloseAllApps_Click" />
                </ContextMenu>
            </Border.ContextMenu>
        </Border>

        <!-- Content layer (always fully opaque) -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Logo -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,25,0" VerticalAlignment="Center"
                        MouseLeftButtonDown="DragBar_MouseLeftButtonDown"
                        Visibility="{Binding ShowBranding, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="🐙" FontSize="14" Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center" Margin="0,0,5,0" />
                <TextBlock Text="Tabu" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource MutedTextBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Tabs -->
            <ItemsControl x:Name="TabsControl" Grid.Column="1" ItemsSource="{Binding Tabs}" Margin="2,0,0,0"
                          ClipToBounds="True">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <helpers:TabsPanel MinTabWidth="24" MaxTabWidth="220"
                                           FixedTabWidth="{Binding UseFixedTabWidth, Converter={StaticResource BoolToFixedTabWidthConverter}}">
                            <b:Interaction.Behaviors>
                                <b:FluidMoveBehavior AppliesTo="Children" Duration="0:0:0.12" Tag="DataContext">
                                    <b:FluidMoveBehavior.EaseX>
                                        <CubicEase EasingMode="EaseOut" />
                                    </b:FluidMoveBehavior.EaseX>
                                    <b:FluidMoveBehavior.EaseY>
                                        <CubicEase EasingMode="EaseOut" />
                                    </b:FluidMoveBehavior.EaseY>
                                </b:FluidMoveBehavior>
                            </b:Interaction.Behaviors>
                        </helpers:TabsPanel>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TabViewModel}">
                        <!-- Outer wrapper expands the drop hit-area to the full
                             tab cell (incl. the vertical gap reserved by the
                             inner TabBorder margin) so external drags catch
                             the tab even when the cursor is near the bar's
                             top/bottom edge. Inner Border keeps the visual
                             chrome unchanged. -->
                        <Border Background="Transparent"
                                AllowDrop="True"
                                DragEnter="Tab_DragEnter"
                                DragOver="Tab_DragOver"
                                DragLeave="Tab_DragLeave"
                                Drop="Tab_Drop">
                            <Border x:Name="TabBorder"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="{Binding DataContext.TabPadding, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                Margin="1,4"
                                Cursor="Hand"
                                RenderTransformOrigin="0.5,0.5"
                                MouseLeftButtonDown="Tab_MouseLeftButtonDown"
                                MouseMove="Tab_MouseMove"
                                MouseLeftButtonUp="Tab_MouseLeftButtonUp"
                                MouseDown="Tab_MouseDown"
                                Tag="{Binding}">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{DynamicResource Tab_Close}"
                                              Click="TabContextClose_Click"
                                              Tag="{Binding}" />
                                    <MenuItem Header="{DynamicResource Tab_KillProcess}"
                                              Click="TabContextKill_Click"
                                              Tag="{Binding}" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                    <TranslateTransform X="0" Y="0" />
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Image Source="{Binding Icon}" Width="16" Height="16"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding Icon, Converter={StaticResource NullToCollapsedConverter}}" />
                                    <!-- Notification dot: shown when the underlying app
                                         flashed the taskbar AND the user has badges on. -->
                                    <Ellipse Width="{Binding DataContext.NotificationDotSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                             Height="{Binding DataContext.NotificationDotSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                             Fill="{DynamicResource NotificationDotBrush}"
                                             Stroke="{DynamicResource PrimaryBackgroundBrush}"
                                             StrokeThickness="1"
                                             HorizontalAlignment="Right" VerticalAlignment="Top"
                                             Margin="0,-1,-2,0">
                                        <Ellipse.Visibility>
                                            <MultiBinding Converter="{StaticResource AllBoolsToVisibilityConverter}">
                                                <Binding Path="HasNotification" />
                                                <Binding Path="DataContext.ShowNotificationBadges"
                                                         RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                            </MultiBinding>
                                        </Ellipse.Visibility>
                                    </Ellipse>
                                </Grid>
                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="11"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                <Button x:Name="CloseBtn" Grid.Column="2"
                                        Style="{DynamicResource TabCloseButtonStyle}"
                                        Click="TabClose_Click"
                                        Tag="{Binding}"
                                        Margin="4,0,0,0"
                                        Visibility="Hidden" />
                            </Grid>
                        </Border>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ActiveTabBackgroundBrush}" />
                                <Setter TargetName="TabBorder" Property="TextBlock.Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                <Setter TargetName="CloseBtn" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <!-- Override the active background with a high-contrast brush when the
                                 acrylic blur is on so the selected tab is clearly distinguishable
                                 against the blurred desktop. -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsActive}" Value="True" />
                                    <Condition Binding="{Binding DataContext.UseBlurEffect, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ActiveTabBackgroundBlurBrush}" />
                            </MultiDataTrigger>
                            <Trigger SourceName="TabBorder" Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBtn" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Clock -->
            <TextBlock x:Name="ClockText" Grid.Column="2"
                       Text="{Binding CurrentTime}"
                       FontSize="{Binding ClockFontSize}"
                       FontWeight="Medium"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       VerticalAlignment="Center"
                       Margin="8,0,12,0"
                       Visibility="{Binding ShowClock, Converter={StaticResource BoolToVisibilityConverter}}" />

            <!-- Settings button. Focusable="False" so keyboard focus never
                 parks on it: otherwise, after the bar is activated (e.g. by
                 clicking a tab), a stray Space/Enter keystroke "clicks" it
                 and the settings window opens on its own. -->
            <Button x:Name="SettingsButton" Grid.Column="3"
                    Click="Settings_Click"
                    Focusable="False" IsTabStop="False"
                    ToolTip="{DynamicResource MainBar_SettingsTooltip}"
                    Style="{DynamicResource TitleBarButtonStyle}"
                    Content="&#xE713;"
                    Width="{Binding BarHeight}" Height="{Binding BarHeight}" />

            <!-- Close button (non-focusable for the same reason as Settings:
                 a stray Enter/Space must never quit the app). -->
            <Button x:Name="CloseButton" Grid.Column="4"
                    Focusable="False" IsTabStop="False"
                    Style="{DynamicResource CloseWindowButtonStyle}"
                    Content="&#xE8BB;" Click="Close_Click"
                    ToolTip="{DynamicResource MainBar_CloseTooltip}"
                    Width="{Binding BarHeight}" Height="{Binding BarHeight}" />
        </Grid>
    </Grid>
</Window>
