<ui:FluentWindow x:Class="Tabu.UI.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:Tabu.UI.Controls"
                 Title="Tabu Settings"
                 Icon="pack://application:,,,/Assets/tabu.ico"
                 Width="960" Height="640"
                 MinWidth="760" MinHeight="480"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 Topmost="True"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterScreen">

    <!-- WPF UI dictionaries are scoped to this window on purpose: merging
         them into App.xaml would restyle the bar and every other window.
         SettingsWindow.xaml.cs swaps the ThemesDictionary (index 0) and
         the accent keys to follow Tabu's theme and accent color. -->
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Tabu palette keys still used by shared controls (color wheel)
                 remapped onto the neutral Fluent palette, so nothing in this
                 window falls back to the bar's navy/purple theme. -->
            <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="{DynamicResource SolidBackgroundFillColorBase}" />
            <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{DynamicResource SolidBackgroundFillColorQuarternary}" />
            <SolidColorBrush x:Key="TertiaryBackgroundBrush" Color="{DynamicResource ControlFillColorDefault}" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="{DynamicResource TextFillColorPrimary}" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="{DynamicResource TextFillColorSecondary}" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="{DynamicResource TextFillColorTertiary}" />
            <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource ControlStrokeColorDefault}" />

            <!-- Side navigation item, modelled on the Windows 11 Settings /
                 PowerToys NavigationView: subtle fill on hover and selection
                 plus an accent pill on the selected item's left edge.
                 RadioButton gives single selection for free via GroupName. -->
            <Style x:Key="SettingsNavItemStyle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="NavBorder" Background="Transparent" CornerRadius="4">
                                <Grid>
                                    <Border x:Name="SelectionPill" Width="3" Height="16" CornerRadius="1.5"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                                            Visibility="Collapsed" />
                                    <ContentPresenter Margin="14,0,12,0" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    <Setter TargetName="SelectionPill" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SettingsNavIconStyle" TargetType="ui:SymbolIcon">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="Margin" Value="0,0,14,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- One setting per card, 4 px apart, like Windows 11 Settings. -->
            <Style x:Key="SettingCardStyle" TargetType="ui:CardControl" BasedOn="{StaticResource {x:Type ui:CardControl}}">
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="MinHeight" Value="64" />
            </Style>

            <Style x:Key="SettingComboStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="MinWidth" Value="200" />
            </Style>

            <Style x:Key="SettingSliderStyle" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
                <Setter Property="Width" Value="200" />
                <Setter Property="IsSnapToTickEnabled" Value="True" />
                <Setter Property="TickFrequency" Value="1" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SettingValueTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="MinWidth" Value="44" />
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,12,0" />
            </Style>

            <!-- Swatch that opens a color wheel popup. -->
            <ControlTemplate x:Key="SwatchButtonTemplate" TargetType="Button">
                <Border CornerRadius="4" Width="32" Height="32"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>

            <Style x:Key="ColorPopupBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SurfaceStrokeColorFlyoutBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="Margin" Value="0,6,0,0" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35" Color="Black" />
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid x:Name="SettingsRoot" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{DynamicResource Settings_Title}"
                     ShowMinimize="False"
                     ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="{DynamicResource TabuLogoImage}" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Side navigation: each item's Tag names the page it shows. -->
            <StackPanel Grid.Column="0" Margin="8,4,8,12">
                <RadioButton x:Name="NavBarLayout" Style="{StaticResource SettingsNavItemStyle}"
                             GroupName="SettingsNav" Tag="BarLayoutPage" IsChecked="True"
                             Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Window24" Style="{StaticResource SettingsNavIconStyle}" />
                        <TextBlock Text="{DynamicResource Settings_Group_BarLayout}" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavAppearance" Style="{StaticResource SettingsNavItemStyle}"
                             GroupName="SettingsNav" Tag="AppearancePage"
                             Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="PaintBrush24" Style="{StaticResource SettingsNavIconStyle}" />
                        <TextBlock Text="{DynamicResource Settings_Group_Appearance}" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavTabs" Style="{StaticResource SettingsNavItemStyle}"
                             GroupName="SettingsNav" Tag="TabsPage"
                             Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="TabDesktop24" Style="{StaticResource SettingsNavIconStyle}" />
                        <TextBlock Text="{DynamicResource Settings_Group_Tabs}" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavSystem" Style="{StaticResource SettingsNavItemStyle}"
                             GroupName="SettingsNav" Tag="SystemPage"
                             Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Settings24" Style="{StaticResource SettingsNavIconStyle}" />
                        <TextBlock Text="{DynamicResource Settings_Group_System}" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <!-- Scrollable content: one page visible at a time. -->
            <ScrollViewer x:Name="PageScroller" Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,0,28,24" MaxWidth="1000">

                    <TextBlock x:Name="PageTitle" Text="{DynamicResource Settings_Group_BarLayout}"
                               FontSize="28" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,4,0,24" />

                    <!-- ============== Page: Bar layout ============== -->
                    <StackPanel x:Name="BarLayoutPage">
                        <ui:CardControl Style="{StaticResource SettingCardStyle}">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="Desktop24" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <TextBlock Text="{DynamicResource Settings_BarDisplay}" />
                            </ui:CardControl.Header>
                            <ComboBox x:Name="BarPlacementCombo" Style="{StaticResource SettingComboStyle}"
                                      SelectionChanged="BarPlacement_Changed">
                                <ComboBoxItem Content="{DynamicResource Settings_PrimaryOnly}" />
                                <ComboBoxItem Content="{DynamicResource Settings_AllMonitors}" />
                            </ComboBox>
                        </ui:CardControl>

                        <ui:CardControl Style="{StaticResource SettingCardStyle}">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="WindowApps24" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <TextBlock Text="{DynamicResource Settings_WindowDetection}" />
                            </ui:CardControl.Header>
                            <ComboBox x:Name="DetectionModeCombo" Style="{StaticResource SettingComboStyle}"
                                      SelectionChanged="DetectionMode_Changed">
                                <ComboBoxItem Content="{DynamicResource Settings_AllWindows}" />
                                <ComboBoxItem Content="{DynamicResource Settings_SameScreen}" />
                            </ComboBox>
                        </ui:CardControl>

                        <ui:CardControl Style="{StaticResource SettingCardStyle}">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="ArrowAutofitHeight24" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <TextBlock Text="{DynamicResource Settings_BarSize}" />
                            </ui:CardControl.Header>
                            <ComboBox x:Name="BarSizeCombo" Style="{StaticResource SettingComboStyle}"
                                      SelectionChanged="BarSize_Changed">
                                <ComboBoxItem Content="{DynamicResource Settings_BarSizeSmall}" />
                                <ComboBoxItem Content="{DynamicResource Settings_BarSizeMedium}" />
                                <ComboBoxItem Content="{DynamicResource Settings_BarSizeLarge}" />
                            </ComboBox>
                        </ui:CardControl>

                        <ui:CardControl Style="{StaticResource SettingCardStyle}">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="Eye24" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <TextBlock Text="{DynamicResource Settings_BarVisibility}" />
                            </ui:CardControl.Header>
                            <ComboBox x:Name="BarVisibilityCombo" Style="{StaticResource SettingComboStyle}"
                                      SelectionChanged="BarVisibility_Changed">
                                <ComboBoxItem Content="{DynamicResource Settings_AlwaysVisible}" />
                                <ComboBoxItem Content="{DynamicResource Settings_AutoHide}" />
                            </ComboBox>
                        </ui:CardControl>
                    </StackPanel>

                    <!-- ============== Page: Appearance ============== -->
                    <StackPanel x:Name="AppearancePage" Visibility="Collapsed">
                        <!-- Background blur (locks theme + opacity) -->
                        <ui:CardControl Style="{StaticResource SettingCardStyle}">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="Blur24" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <TextBlock Text="{DynamicResource Settings_Blur}" />
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="BlurToggle"
                                             OnContent="{DynamicResource Settings_BlurEnable}"
                                             OffContent="{DynamicResource Settings_BlurDisable}"
                                             Checked="Blur_Changed" Unchecked="Blur_Changed" />
                        </ui:CardControl>

                        <!-- Theme (lockable) -->
                        <Grid x:Name="ThemeSection">
                            <ui:CardControl x:Name="ThemeContent" Style="{StaticResource SettingCardStyle}">
                                <ui:CardControl.Icon>
                                    <ui:SymbolIcon Symbol="DarkTheme24" />
                                </ui:CardControl.Icon>
                                <ui:CardControl.Header>
                                    <TextBlock Text="{DynamicResource Settings_Theme}" />
                                </ui:CardControl.Header>
                                <ComboBox x:Name="ThemeCombo" Style="{StaticResource SettingComboStyle}"
                                          SelectionChanged="Theme_Changed">
                                    <ComboBoxItem Content="{DynamicResource Settings_ThemeSystem}" />
                                    <ComboBoxItem Content="{DynamicResource Settings_ThemeDark}" />
                                    <ComboBoxItem Content="{DynamicResource Settings_ThemeLight}" />
                                </ComboBox>
                            </ui:CardControl>
                            <!-- Click-blocker overlay shown when blur is on -->
                            <Border x:Name="ThemeLockOverlay" Background="Transparent" Visibility="Collapsed"
                                    MouseLeftButtonDown="LockedSection_Click" Cursor="No" />
                        </Grid>

                        <!-- Bar opacity (lockable) -->
                        <Grid x:Name="OpacitySection">
                            <ui:CardControl x:Name="OpacityContent" Style="{StaticResource SettingCardStyle}">
                                <ui:CardControl.Icon>
                                    <ui:SymbolIcon Symbol="BrightnessHigh24" />
                                </ui:CardControl.Icon>
                                <ui:CardControl.Header>
                                    <TextBlock Text="{DynamicResource Settings_BarOpacity}" />
                                </ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="OpacityValueText" Style="{StaticResource SettingValueTextStyle}" Text="100%" />
                                    <Slider x:Name="OpacitySlider" Style="{StaticResource SettingSliderStyle}"
                                            Minimum="30" Maximum="100" Value="100"
                                            ValueChanged="Opacity_Changed" />
                                </StackPanel>
                            </ui:CardControl>
                            <Border x:Name="OpacityLockOverlay" Background="Transparent" Visibility="Collapsed"
                                    MouseLeftButtonDown="LockedSection_Click" Cursor="No" />
                        </Grid>

                        <!-- Accent color: swatch button opens an HSV color wheel popup. -->
                        <ui:CardControl Style="{StaticResource SettingCardStyle}">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="Color24" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <TextBlock Text="{DynamicResource Settings_AccentColor}" />
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="AccentColorSwatchButton" Template="{StaticResource SwatchButtonTemplate}"
                                        Click="AccentColorSwatch_Click" Margin="0,0,8,0">
                                    <Ellipse Width="16" Height="16" Fill="{DynamicResource AccentBrush}" />
                                </Button>
                                <TextBox x:Name="AccentColorBox" Width="110"
                                         TextChanged="AccentColor_TextChanged"
                                         ToolTip="#RRGGBB" />
                                <Button Content="{DynamicResource Settings_AccentColorReset}"
                                        Click="AccentColorReset_Click" Margin="8,0,0,0" />
                            </StackPanel>
                        </ui:CardControl>

                        <Popup x:Name="AccentColorPopup" StaysOpen="False"
                               Placement="Bottom" PlacementTarget="{Binding ElementName=AccentColorSwatchButton}"
                               AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Style="{StaticResource ColorPopupBorderStyle}">
                                <controls:ColorWheelPicker x:Name="AccentColorWheel"
                                                           SelectedColorChanged="AccentColorWheel_SelectedColorChanged" />
                            </Border>
                        </Popup>

                        <!-- Branding -->
                        <ui:CardControl Style="{StaticResource SettingCardStyle}">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="Image24" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <TextBlock Text="{DynamicResource Settings_Branding}" />
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="BrandingToggle"
                                             OnContent="{DynamicResource Settings_ShowLogo}"
                                             OffContent="{DynamicResource Settings_HideLogo}"
                                             Checked="Branding_Changed" Unchecked="Branding_Changed" />
                        </ui:CardControl>
                    </StackPanel>

                    <!-- ============== Page: Tabs ============== -->
                    <StackPanel x:Name="TabsPage" Visibility="Collapsed">
                        <ui:CardControl Style="{StaticResource SettingCardStyle}">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="ArrowAutofitWidth24" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <TextBlock Text="{DynamicResource Settings_TabWidth}" />
                            </ui:CardControl.Header>
                            <ComboBox x:Name="TabWidthCombo" Style="{StaticResource SettingComboStyle}"
                                      SelectionChanged="TabWidth_Changed">
                                <ComboBoxItem Content="{DynamicResource Settings_FullWidth}" />
                                <ComboBoxItem Content="{DynamicResource Settings_FixedWidth}" />
                            </ComboBox>
                        </ui:CardControl>

                        <!-- Clock -->
                        <ui:CardControl Style="{StaticResource SettingCardStyle}">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="Clock24" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <TextBlock Text="{DynamicResource Settings_Clock}" />
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="ClockToggle"
                                             OnContent="{DynamicResource Settings_ShowClock}"
                                             OffContent="{DynamicResource Settings_HideClock}"
                                             Checked="Clock_Changed" Unchecked="Clock_Changed" />
                        </ui:CardControl>

                        <!-- Clock size (only relevant when the clock is visible) -->
                        <ui:CardControl x:Name="ClockSizePanel" Style="{StaticResource SettingCardStyle}">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="TextFontSize24" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <TextBlock Text="{DynamicResource Settings_ClockSize}" />
                            </ui:CardControl.Header>
                            <ComboBox x:Name="ClockSizeCombo" Style="{StaticResource SettingComboStyle}"
                                      SelectionChanged="ClockSize_Changed">
                                <ComboBoxItem Content="{DynamicResource Settings_BarSizeSmall}" />
                                <ComboBoxItem Content="{DynamicResource Settings_BarSizeMedium}" />
                                <ComboBoxItem Content="{DynamicResource Settings_BarSizeLarge}" />
                            </ComboBox>
                        </ui:CardControl>

                        <!-- Notification badges -->
                        <ui:CardControl Style="{StaticResource SettingCardStyle}">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="AlertBadge24" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <TextBlock Text="{DynamicResource Settings_Notifications}" />
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="NotificationsToggle"
                                             OnContent="{DynamicResource Settings_NotificationsEnable}"
                                             OffContent="{DynamicResource Settings_NotificationsDisable}"
                                             Checked="Notifications_Changed" Unchecked="Notifications_Changed" />
                        </ui:CardControl>

                        <!-- Notification dot size + color (only when enabled) -->
                        <StackPanel x:Name="NotificationDotPanel">
                            <ui:CardControl Style="{StaticResource SettingCardStyle}">
                                <ui:CardControl.Icon>
                                    <ui:SymbolIcon Symbol="Circle24" />
                                </ui:CardControl.Icon>
                                <ui:CardControl.Header>
                                    <TextBlock Text="{DynamicResource Settings_NotificationDotSize}" />
                                </ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="NotificationDotSizeValueText" Style="{StaticResource SettingValueTextStyle}" Text="7 px" />
                                    <Slider x:Name="NotificationDotSizeSlider" Style="{StaticResource SettingSliderStyle}"
                                            Minimum="4" Maximum="12" Value="7"
                                            ValueChanged="NotificationDotSize_Changed" />
                                </StackPanel>
                            </ui:CardControl>

                            <ui:CardControl Style="{StaticResource SettingCardStyle}">
                                <ui:CardControl.Icon>
                                    <ui:SymbolIcon Symbol="PaintBucket24" />
                                </ui:CardControl.Icon>
                                <ui:CardControl.Header>
                                    <TextBlock Text="{DynamicResource Settings_NotificationDotColor}" />
                                </ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <!-- Swatch acts as a button that opens the wheel popup. -->
                                    <Button x:Name="DotColorSwatchButton" Template="{StaticResource SwatchButtonTemplate}"
                                            Click="DotColorSwatch_Click" Margin="0,0,8,0">
                                        <Ellipse x:Name="NotificationDotPreview" Width="16" Height="16"
                                                 Fill="{DynamicResource NotificationDotBrush}" />
                                    </Button>
                                    <TextBox x:Name="NotificationDotColorBox" Width="110"
                                             TextChanged="NotificationDotColor_TextChanged"
                                             ToolTip="#RRGGBB" />
                                    <Button Content="{DynamicResource Settings_NotificationDotColorReset}"
                                            Click="NotificationDotColorReset_Click" Margin="8,0,0,0" />
                                </StackPanel>
                            </ui:CardControl>

                            <!-- Color wheel popup, anchored to the swatch button. -->
                            <Popup x:Name="DotColorPopup" StaysOpen="False"
                                   Placement="Bottom" PlacementTarget="{Binding ElementName=DotColorSwatchButton}"
                                   AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Style="{StaticResource ColorPopupBorderStyle}">
                                    <controls:ColorWheelPicker x:Name="DotColorWheel"
                                                               SelectedColorChanged="DotColorWheel_SelectedColorChanged" />
                                </Border>
                            </Popup>
                        </StackPanel>

                        <!-- Active tab tint (color + opacity) -->
                        <ui:CardControl Style="{StaticResource SettingCardStyle}">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="ColorBackground24" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <TextBlock Text="{DynamicResource Settings_ActiveTab}" />
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ActiveTabColorSwatchButton" Template="{StaticResource SwatchButtonTemplate}"
                                        Click="ActiveTabColorSwatch_Click" Margin="0,0,8,0">
                                    <Rectangle Width="18" Height="18" RadiusX="4" RadiusY="4"
                                               Fill="{DynamicResource ActiveTabBackgroundBrush}" />
                                </Button>
                                <TextBox x:Name="ActiveTabColorBox" Width="110"
                                         TextChanged="ActiveTabColor_TextChanged"
                                         ToolTip="#RRGGBB" />
                                <Button Content="{DynamicResource Settings_NotificationDotColorReset}"
                                        Click="ActiveTabColorReset_Click" Margin="8,0,0,0" />
                            </StackPanel>
                        </ui:CardControl>

                        <ui:CardControl Style="{StaticResource SettingCardStyle}">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="CircleHalfFill24" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <TextBlock Text="{DynamicResource Settings_ActiveTabOpacity}" />
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ActiveTabOpacityValueText" Style="{StaticResource SettingValueTextStyle}" Text="100%" />
                                <Slider x:Name="ActiveTabOpacitySlider" Style="{StaticResource SettingSliderStyle}"
                                        Minimum="0" Maximum="100" Value="100"
                                        ValueChanged="ActiveTabOpacity_Changed" />
                            </StackPanel>
                        </ui:CardControl>

                        <Popup x:Name="ActiveTabColorPopup" StaysOpen="False"
                               Placement="Bottom" PlacementTarget="{Binding ElementName=ActiveTabColorSwatchButton}"
                               AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Style="{StaticResource ColorPopupBorderStyle}">
                                <controls:ColorWheelPicker x:Name="ActiveTabColorWheel"
                                                           SelectedColorChanged="ActiveTabColorWheel_SelectedColorChanged" />
                            </Border>
                        </Popup>
                    </StackPanel>

                    <!-- ============== Page: System ============== -->
                    <StackPanel x:Name="SystemPage" Visibility="Collapsed">
                        <ui:CardControl Style="{StaticResource SettingCardStyle}">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="LocalLanguage24" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <TextBlock Text="{DynamicResource Settings_Language}" />
                            </ui:CardControl.Header>
                            <ComboBox x:Name="LanguageCombo" Style="{StaticResource SettingComboStyle}"
                                      SelectionChanged="Language_Changed" />
                        </ui:CardControl>

                        <ui:CardControl Style="{StaticResource SettingCardStyle}">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="Power24" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <TextBlock Text="{DynamicResource Settings_Startup}" />
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="StartupToggle"
                                             OnContent="{DynamicResource Settings_StartAtLogin}"
                                             OffContent="{DynamicResource Settings_DontStartAtLogin}"
                                             Checked="Startup_Changed" Unchecked="Startup_Changed" />
                        </ui:CardControl>

                        <ui:CardControl Style="{StaticResource SettingCardStyle}">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="ArrowSync24" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <TextBlock Text="{DynamicResource Settings_Updates}" />
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="CheckUpdatesNowButton"
                                        Content="{DynamicResource Settings_CheckUpdatesNow}"
                                        Click="CheckUpdatesNow_Click"
                                        Margin="0,0,16,0" />
                                <ui:ToggleSwitch x:Name="AutoUpdatesToggle"
                                                 OnContent="{DynamicResource Settings_AutoUpdatesEnable}"
                                                 OffContent="{DynamicResource Settings_AutoUpdatesDisable}"
                                                 Checked="AutoUpdates_Changed" Unchecked="AutoUpdates_Changed" />
                            </StackPanel>
                        </ui:CardControl>

                        <ui:CardControl Style="{StaticResource SettingCardStyle}">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="ArrowReset24" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <TextBlock Text="{DynamicResource Settings_Reset}" />
                            </ui:CardControl.Header>
                            <Button x:Name="ResetSettingsButton"
                                    Content="{DynamicResource Settings_ResetConfirmTitle}"
                                    Click="ResetSettings_Click" />
                        </ui:CardControl>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Toast banner overlay (Grid.RowSpan covers the full window) -->
        <Border x:Name="ToastBanner"
                Grid.Row="0" Grid.RowSpan="2"
                Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
                BorderThickness="1" CornerRadius="8" Padding="16,10"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,32"
                MinWidth="240" MaxWidth="420"
                Opacity="0"
                IsHitTestVisible="False"
                RenderTransformOrigin="0.5,1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35" Color="Black" />
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastTranslate" Y="20" />
            </Border.RenderTransform>
            <TextBlock x:Name="ToastText"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       TextAlignment="Center" />
        </Border>
    </Grid>
</ui:FluentWindow>
