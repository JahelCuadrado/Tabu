<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Background -->
    <Color x:Key="PrimaryBackgroundColor">#1A1A2E</Color>
    <Color x:Key="SecondaryBackgroundColor">#16213E</Color>
    <Color x:Key="TertiaryBackgroundColor">#0F3460</Color>
    <Color x:Key="ActiveTabBackgroundColor">#36365e</Color>

    <!-- Accent -->
    <Color x:Key="AccentColor">#533483</Color>
    <Color x:Key="AccentHoverColor">#6A42A0</Color>
    <Color x:Key="AccentPressedColor">#4A2D75</Color>

    <!-- Text -->
    <Color x:Key="PrimaryTextColor">#E8E8E8</Color>
    <Color x:Key="SecondaryTextColor">#A0A0B0</Color>
    <Color x:Key="MutedTextColor">#606078</Color>

    <!-- Status -->
    <Color x:Key="DangerColor">#E74C3C</Color>
    <Color x:Key="DangerHoverColor">#FF6B5A</Color>
    <Color x:Key="SuccessColor">#2ECC71</Color>

    <!-- Borders -->
    <Color x:Key="BorderColor">#2A2A4A</Color>
    <Color x:Key="BorderHoverColor">#3A3A5A</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="{StaticResource PrimaryBackgroundColor}" />
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{StaticResource SecondaryBackgroundColor}" />
    <SolidColorBrush x:Key="TertiaryBackgroundBrush" Color="{StaticResource TertiaryBackgroundColor}" />
    <SolidColorBrush x:Key="ActiveTabBackgroundBrush" Color="{StaticResource ActiveTabBackgroundColor}" />
    <!-- Higher-contrast active tab brush used when acrylic blur is on, since the blurred backdrop washes out the regular shade. -->
    <SolidColorBrush x:Key="ActiveTabBackgroundBlurBrush" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHoverColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderHoverBrush" Color="{StaticResource BorderHoverColor}" />

    <!-- "Tabu" wordmark next to the bar logo: the icon's purple-to-blue
         strip, lightened so it stays readable on the bar. -->
    <LinearGradientBrush x:Key="TabuWordmarkBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Offset="0" Color="#B9A2FF" />
        <GradientStop Offset="0.55" Color="#8C97FF" />
        <GradientStop Offset="1" Color="#5CC6F2" />
    </LinearGradientBrush>

    <!-- Logo face gradient, absolute so eyes and smile share one sweep. -->
    <LinearGradientBrush x:Key="TabuLogoFaceBrush" MappingMode="Absolute"
                         StartPoint="78,130" EndPoint="178,210">
        <GradientStop Offset="0" Color="#8B6CF8" />
        <GradientStop Offset="1" Color="#2196E3" />
    </LinearGradientBrush>

    <!-- Tabu logo (dark), vector copy of the 16-32 px icon variant so
         the bar and settings title stay crisp at any DPI. Swapped with
         this dictionary, so it follows the theme. -->
    <DrawingImage x:Key="TabuLogoImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Transparent square keeps the 256x256 bounds (and aspect). -->
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H256 V256 H0Z" />
                <DrawingGroup>
                    <DrawingGroup.ClipGeometry>
                        <RectangleGeometry Rect="8,24,240,208" RadiusX="32" RadiusY="32" />
                    </DrawingGroup.ClipGeometry>
                    <GeometryDrawing Geometry="M8,24 H248 V232 H8Z">
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.6">
                                <GradientStop Offset="0" Color="#9F7AFA" />
                                <GradientStop Offset="0.55" Color="#5D6CF2" />
                                <GradientStop Offset="1" Color="#16A6DE" />
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M8,96 C22,96 26,90 26,78 V68 A16,16 0 0 1 42,52 H134 A16,16 0 0 1 150,68 V78 C150,90 154,96 168,96 H248 V232 H8Z">
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1">
                                <GradientStop Offset="0" Color="#2E3142" />
                                <GradientStop Offset="1" Color="#191B26" />
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                    </GeometryDrawing>
                </DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#2EFFFFFF" Thickness="2" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="9,25,238,206" RadiusX="31" RadiusY="31" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Face -->
                <DrawingGroup>
                    <DrawingGroup.Children>
                        <GeometryDrawing Brush="{StaticResource TabuLogoFaceBrush}">
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <EllipseGeometry Center="98,150" RadiusX="20" RadiusY="20" />
                                    <EllipseGeometry Center="158,150" RadiusX="20" RadiusY="20" />
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="White">
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <EllipseGeometry Center="91,142" RadiusX="7" RadiusY="7" />
                                    <EllipseGeometry Center="151,142" RadiusX="7" RadiusY="7" />
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Geometry="M100,190 Q128,210 156,190">
                            <GeometryDrawing.Pen>
                                <Pen Brush="{StaticResource TabuLogoFaceBrush}" Thickness="14"
                                     StartLineCap="Round" EndLineCap="Round" />
                            </GeometryDrawing.Pen>
                        </GeometryDrawing>
                    </DrawingGroup.Children>
                </DrawingGroup>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

</ResourceDictionary>
